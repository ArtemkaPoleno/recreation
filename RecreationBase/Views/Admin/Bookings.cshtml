@model List<BookingRecord>
@{
    ViewData["Title"] = "Заявки — админка";

    string StatusText(BookingStatus s) => s switch
    {
        BookingStatus.New => "Новая",
        BookingStatus.Confirmed => "Подтверждена",
        BookingStatus.Cancelled => "Отменена",
        _ => "Завершена"
    };

    var current = ViewBag.Status as BookingStatus?;
}

<section class="page">
    <p class="kicker">Администрирование</p>
    <h1 style="font-family:var(--serif);font-weight:500;font-size:clamp(3rem,5.5vw,4.8rem);letter-spacing:-0.03em;line-height:0.95">Заявки</h1>

    <partial name="_AdminNav" />

    <form method="get" asp-action="Bookings" class="admin-filters">
        <div class="field">
            <label for="q">Поиск</label>
            <input id="q" name="q" type="text" value="@ViewBag.Query" placeholder="имя, телефон, email" />
        </div>
        <div class="field">
            <label for="from">С даты</label>
            <input id="from" name="from" type="date" value="@ViewBag.From" />
        </div>
        <div class="field">
            <label for="to">По дату</label>
            <input id="to" name="to" type="date" value="@ViewBag.To" />
        </div>
        <div class="field">
            <label for="status">Статус</label>
            <select id="status" name="status">
                <option value="">Любой</option>
                <option value="New" selected="@(current == BookingStatus.New)">Новая</option>
                <option value="Confirmed" selected="@(current == BookingStatus.Confirmed)">Подтверждена</option>
                <option value="Cancelled" selected="@(current == BookingStatus.Cancelled)">Отменена</option>
                <option value="Completed" selected="@(current == BookingStatus.Completed)">Завершена</option>
            </select>
        </div>
        <button class="book book--ink" type="submit">Применить</button>
        <a class="text-link text-link--light" asp-action="Bookings">Сбросить</a>
    </form>

    @if (Model.Count == 0)
    {
        <p class="empty">По фильтрам заявок не нашлось.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Гость</th>
                        <th>Контакт</th>
                        <th>Домик</th>
                        <th>Даты</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td>
                                @b.GuestName
                                @if (b.UserId != null)
                                {
                                    <em class="table-sub">аккаунт: @(b.User?.Email ?? "—")</em>
                                }
                            </td>
                            <td>
                                @b.Phone
                                @if (!string.IsNullOrEmpty(b.Email))
                                {
                                    <em class="table-sub">@b.Email</em>
                                }
                            </td>
                            <td>@b.Cabin?.Name</td>
                            <td>@b.CheckIn.ToString("dd.MM") — @b.CheckOut.ToString("dd.MM.yyyy") · @b.Guests гост.</td>
                            <td>@b.TotalPrice.ToString("N0") ₽</td>
                            <td><span class="status status--@((int)b.Status)">@StatusText(b.Status)</span></td>
                            <td class="table-actions">
                                <a class="table-link" asp-action="BookingDetails" asp-route-id="@b.Id">Открыть</a>
                                @if (b.Status == BookingStatus.New)
                                {
                                    <form method="post" asp-action="SetStatus" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <input type="hidden" name="status" value="@BookingStatus.Confirmed" />
                                        <button type="submit" class="table-link table-link--ok">Подтвердить</button>
                                    </form>
                                }
                                @if (b.Status is BookingStatus.New or BookingStatus.Confirmed)
                                {
                                    <form method="post" asp-action="SetStatus" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <input type="hidden" name="status" value="@BookingStatus.Cancelled" />
                                        <button type="submit" class="table-link table-link--bad">Отменить</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
